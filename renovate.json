{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    "group:allNonMajor",
    "schedule:nonOfficeHours",
    ":separateMultipleMajorReleases",
    ":automergeMinor",
    ":gitSignOff"
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "extends": [
      "group:allNonMajor",
      "schedule:daily"
    ]
  },
  "automergeStrategy": "rebase",
  "rangeStrategy": "widen",
  "minimumReleaseAge": "3 days",
  "labels": ["dependencies"],
  "packageRules": [
    {
      "matchDepTypes": ["devDependencies"],
      "automerge": true,
      "groupName": "dev dependencies"
    }
  ]
}
